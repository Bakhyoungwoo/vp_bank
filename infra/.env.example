# Copy this file to infra/.env on the deployment server and fill every secret.
MYSQL_DATABASE=vapdb
MYSQL_USER=vap
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/vapdb?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=vap
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://your-domain.example
OPENAI_API_KEY=
