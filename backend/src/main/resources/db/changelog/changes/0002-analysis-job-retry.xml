<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0002-analysis-job-retry" author="vap">
        <comment>멈춘 job 자동 복구 배치를 위한 재시도 횟수/마지막 시도 시각 컬럼 추가</comment>
        <addColumn tableName="analysis_job">
            <column name="retry_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_attempt_at" type="DATETIME(6)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
