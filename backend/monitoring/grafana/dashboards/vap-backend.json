      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "title": "HTTP 5xx responses",
      "type": "timeseries",
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"vap-backend\",status=~\"5..\"}[5m]))", "legendFormat": "5xx/sec", "refId": "A"}]
    }
